{
  "expo": {
    "name": "Drively",
    "slug": "Drively",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow Drively to detect driving and keep accurate practice logs.",
          "locationWhenInUsePermission": "Allow Drively to use your location for weather, distance, and drive detection."
        }
      ],
      "expo-notifications",
      "expo-document-picker",
      "expo-file-system",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "3fc48f4e-d36f-4c74-aba9-2f6d337412a4"
      }
    },
    "android": {
      "package": "com.jaysapps.drively",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A62A4"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true,
      "runtimeVersion": "1.1.3"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "jay_b_1029",
    "updates": {
      "url": "https://u.expo.dev/3fc48f4e-d36f-4c74-aba9-2f6d337412a4"
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}
