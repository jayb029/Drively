<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- The app moves data here only after the user enables Android cloud backup. -->
    <include domain="file" path="drively/cloud/" />
  </cloud-backup>
  <device-transfer>
    <!-- Device-to-device transfer remains available regardless of the cloud preference. -->
    <include domain="file" path="drively/local/" />
    <include domain="file" path="drively/cloud/" />
  </device-transfer>
</data-extraction-rules>
